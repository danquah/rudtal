// S08 additive fragment. Merge these entries into the existing tailnet policy;
// do not replace unrelated policy, ACLs, tags, routes, tests, or JetKVM rules.
// Replace the placeholder with the exact Tailscale login of the approved routine
// administrator before saving in the Tailscale admin console. This file has no
// credential, tailnet name, MagicDNS name, auth key, or device identifier.
{
  "groups": {
    "group:rudtal-k8s-routine-readers": [
      "REPLACE_WITH_TAILSCALE_LOGIN",
    ],
  },

  "tagOwners": {
    "tag:rudtal-k8s-operator": [],
    "tag:rudtal-k8s-api": ["tag:rudtal-k8s-operator"],
    "tag:rudtal-k8s-unexposed": ["tag:rudtal-k8s-operator"],
  },

  // Dedicated API proxies advertise a Tailscale Service. This does not approve
  // any future proxy carrying tag:rudtal-k8s-unexposed.
  "autoApprovers": {
    "services": {
      "svc:*": ["tag:rudtal-k8s-api"],
    },
  },

  "grants": [
    {
      // Connectivity and the Kubernetes impersonation group are both needed.
      // No grant reaches the Operator device, LAN nodes, Talos API, subnet
      // routes, exit nodes, or any unreviewed future Service proxy.
      "src": ["group:rudtal-k8s-routine-readers"],
      "dst": ["tag:rudtal-k8s-api"],
      "ip": ["tcp:443"],
      "app": {
        "tailscale.com/cap/kubernetes": [
          { "impersonate": { "groups": ["rudtal-k8s-routine-readers"] } },
        ],
      },
    },
  ],

  "tests": [
    {
      "src": "group:rudtal-k8s-routine-readers",
      "accept": ["tag:rudtal-k8s-api:443"],
      "deny": [
        "tag:rudtal-k8s-operator:443",
        "tag:rudtal-k8s-unexposed:443",
      ],
    },
  ],
}
